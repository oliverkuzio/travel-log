# Wrangler-style local secrets, proxied into `platform.env` during `vite dev` / `wrangler dev`.
# Copy to `.dev.vars` (untracked) and fill in real values.
# For production, set these with `wrangler secret put <NAME>` instead of committing them.

# Random string used to sign session tokens/cookies, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Overrides the production BETTER_AUTH_URL set in wrangler.jsonc's `vars`.
BETTER_AUTH_URL=http://localhost:5173

# GitHub OAuth App credentials: https://github.com/settings/developers
# Authorization callback URL: <origin>/api/auth/callback/github
# (http://localhost:5173/api/auth/callback/github for local dev)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# MapTiler API for map visualisation
MAPTILER_API_KEY=

NODE_ENV=development

# Cloudflare D1 credentials — only needed for `drizzle-kit push/studio`
# (migrations are applied via `wrangler d1 migrations apply`)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_TOKEN=
CLOUDFLARE_DATABASE_ID=

# Sentry org/project slugs — read by @sentry/nuxt in `nuxt.config.ts` at build time
# to upload source maps (Settings → Organization → General / Projects → <project>)
SENTRY_ORG=
SENTRY_PROJECT=

# Build-time (not `.dev.vars`) — Sentry's Cloudflare Workers integration needs the
# DSN at module-evaluation time, before any request/platform.env is available, so it
# can't go through the usual platform.env bindings. Copy to `.env` (untracked) and
# fill in your project's DSN from Sentry: Settings → Projects → <project> → Client Keys (DSN).
# A DSN isn't a secret — it's safe to expose client-side — so it also needs to be set
# wherever `pnpm build`/`pnpm deploy` runs (CI, or your machine).
VITE_SENTRY_DSN=

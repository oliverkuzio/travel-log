NODE_ENV=development

# Public S3/R2 bucket URL (used by Nuxt runtimeConfig at build time)
# Also set S3_BUCKET_URL in wrangler.jsonc vars for the Worker runtime
NUXT_PUBLIC_S3_BUCKET_URL=

# Cloudflare D1 credentials — only needed for `drizzle-kit push/studio`
# (migrations are applied via `wrangler d1 migrations apply`)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_TOKEN=
CLOUDFLARE_DATABASE_ID=

# Sentry — used at build time by @sentry/nuxt
SENTRY_ORG=
SENTRY_PROJECT=

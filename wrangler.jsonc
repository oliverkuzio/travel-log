/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
// TODO: Add auto-deployment to Cloudflare as part of Github CI
// Deploying your own copy? Replace every value marked "Deployment-specific" (see README → Deploying your own copy).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travel-log",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-04-30",
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  },
  "observability": {
    "enabled": true
  },
  // Deployment-specific: your own custom domain, or remove `routes` to use the workers.dev URL.
  "routes": [
    {
      "pattern": "travel.kuzio.app",
      "custom_domain": true
    }
  ],

  /**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": { "mode": "smart" },

  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travel-log",
      // Deployment-specific: the id printed by `wrangler d1 create travel-log`.
      "database_id": "3b9e3acb-8bc6-4ec8-90f9-ffbf3c9eaa71",
      "migrations_dir": "./lib/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET", // <~ valid JavaScript variable name
      // Deployment-specific: create with `wrangler r2 bucket create travel-log --jurisdiction eu`, or drop `jurisdiction`.
      "bucket_name": "travel-log",
      "jurisdiction": "eu"
    }
  ],

  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   */
  "vars": {
    // Not secret — Better Auth's own recommended way to pin its base origin
    // instead of trusting request headers. Overridden to localhost for
    // local dev via `.dev.vars` (which takes precedence over this).
    // Deployment-specific: its host is also allowed by Better Auth and sent to Nominatim as the User-Agent.
    "BETTER_AUTH_URL": "https://travel.kuzio.app",
    // Deployment-specific: comma-separated extra hosts Better Auth accepts, e.g. the workers.dev preview URL.
    "AUTH_ALLOWED_HOSTS": "*.empty-queen-0060.workers.dev",
    // Not secret — Sentry org/project slugs. Informational only: @sentry/nuxt
    // reads these from `process.env` at build time (see `nuxt.config.ts`) for
    // source map uploads, so they must also be set in `.env` / CI.
    // Deployment-specific.
    "SENTRY_ORG": "ok-apps",
    "SENTRY_PROJECT": "travel-log"
  }

  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": { "directory": "./public/", "binding": "ASSETS" },

  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}

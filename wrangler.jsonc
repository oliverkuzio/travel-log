/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
// TODO: Add auto-deployment to Cloudflare as part of Github CI
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travel-log",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-04-30",
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "travel.kuzio.app",
      "custom_domain": true
    }
  ],

  /**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": { "mode": "smart" },

  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  "d1_databases": [
    {
      "binding": "travel_log_database",
      "database_name": "travel-log",
      "database_id": "3b9e3acb-8bc6-4ec8-90f9-ffbf3c9eaa71",
      "migrations_dir": "./lib/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "travel_log_bucket", // <~ valid JavaScript variable name
      "bucket_name": "travel-log",
      "jurisdiction": "eu"
    }
  ],

  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   */
  "vars": {
    "AUTH_GITHUB_CLIENT_ID": "Ov23liXgrX6aM6fwSiJq",
    "S3_ACCESS_KEY": "4a6c9902d570d9c30b5e7943006ab2f9",
    "S3_BUCKET": "travel-log",
    "S3_BUCKET_URL": "https://f3aea88fbb8e74db66c7e2f039fa9fee.eu.r2.cloudflarestorage.com/travel-log",
    "S3_ENDPOINT": "https://f3aea88fbb8e74db66c7e2f039fa9fee.eu.r2.cloudflarestorage.com",
    "S3_REGION": "eu",
    "SENTRY_ORG": "ok-apps",
    "SENTRY_PROJECT": "travel-log"
  }

  /**
   * Secrets — upload via `wrangler secret put <NAME>` for production.
   * For local development, add to `.dev.vars`:
   *   AUTH_GITHUB_CLIENT_ID (dev OAuth app)
   *   AUTH_GITHUB_CLIENT_SECRET
   *   BETTER_AUTH_SECRET
   *   S3_ACCESS_SECRET
   *   VITE_SENTRY_DSN
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */

  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": { "directory": "./public/", "binding": "ASSETS" },

  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]

}
